rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditorOrAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnLastLoginUpdate() {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);
    }

    function isViewStatsUpdate() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewedAt'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
    }

    match /insights/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || isViewStatsUpdate();
    }
    match /gospelInsights/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || isViewStatsUpdate();
    }
    match /otherInsights/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || isViewStatsUpdate();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin() || isOwnLastLoginUpdate();
      allow delete: if isAdmin();
    }

    match /invitations/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == docId);
      allow write: if isAdmin();
    }

    match /emailNotifications/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
