rules_version = '2';



service cloud.firestore {

  match /databases/{database}/documents {



    function isEditorOrAdmin() {

      return request.auth != null

        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];

    }



    function isAdmin() {

      return request.auth != null

        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

    }



    function isOwnLastLoginUpdate() {

      return request.auth != null

        && request.auth.uid == userId

        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);

    }



    function isViewStatsUpdate() {

      return request.auth != null

        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewedAt'])

        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;

    }



    function isValidFeedbackCreate() {

      return request.auth != null

        && request.resource.data.userId == request.auth.uid

        && request.resource.data.userEmail == request.auth.token.email

        && request.resource.data.type in ['suggestion', 'bug', 'content', 'other']

        && request.resource.data.message is string

        && request.resource.data.message.size() >= 10

        && request.resource.data.message.size() <= 2000

        && request.resource.data.status == 'new';

    }



    function isFeedbackStatusUpdate() {

      return isAdmin()

        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])

        && request.resource.data.status == 'read';

    }



    // General Conference talk docs — whitelist fields; block transcript-like keys (262144 = gc-import-constants.js)

    function isValidGcTalkData() {

      return request.resource.data.keys().hasOnly([

          'talkId', 'speaker', 'title', 'start', 'end', 'sessionKey',

          'outlineMarkdown', 'outlineSyncedAt', 'sourceTalkUrl'

        ])

        && request.resource.data.talkId is string

        && request.resource.data.talkId.size() <= 128

        && request.resource.data.speaker is string

        && request.resource.data.speaker.size() <= 500

        && request.resource.data.title is string

        && request.resource.data.title.size() <= 1000

        && request.resource.data.sessionKey in ['sat-am', 'sat-pm', 'sun-am', 'sun-pm']

        && request.resource.data.outlineMarkdown is string

        && request.resource.data.outlineMarkdown.size() <= 262144

        && request.resource.data.sourceTalkUrl is string

        && request.resource.data.sourceTalkUrl.size() <= 512;

    }



    function isValidGcSessionData() {

      return request.resource.data.keys().hasOnly([

          'label', 'source', 'timezone', 'sessionWindows', 'lastSyncedAt',

          'importFrozen', 'importFrozenAt'

        ])

        && (!('label' in request.resource.data) || (

          request.resource.data.label is string && request.resource.data.label.size() <= 200

        ))

        && (!('importFrozen' in request.resource.data) || request.resource.data.importFrozen is bool);

    }



    // Role assigned on signup: invitation role if valid, otherwise 'user' only.

    function signupRole() {

      let inviteRef = /databases/$(database)/documents/invitations/$(request.auth.token.email);

      return exists(inviteRef) && get(inviteRef).data.role in ['admin', 'editor', 'user']

        ? get(inviteRef).data.role

        : 'user';

    }



    function isValidUserCreate() {

      return request.auth != null

        && request.auth.uid == userId

        && request.auth.token.email != null

        && request.resource.data.email == request.auth.token.email

        && request.resource.data.role == signupRole()

        && request.resource.data.name is string

        && request.resource.data.name.size() >= 1

        && request.resource.data.name.size() <= 100

        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'createdAt']);

    }



    match /insights/{docId} {

      allow read: if request.auth != null;

      allow create, delete: if isEditorOrAdmin();

      allow update: if isEditorOrAdmin() || isViewStatsUpdate();

    }

    match /gospelInsights/{docId} {

      allow read: if request.auth != null;

      allow create, delete: if isEditorOrAdmin();

      allow update: if isEditorOrAdmin() || isViewStatsUpdate();

    }

    match /otherInsights/{docId} {

      allow read: if request.auth != null;

      allow create, delete: if isEditorOrAdmin();

      allow update: if isEditorOrAdmin() || isViewStatsUpdate();

    }



    // General Conference outlines (Conference Companion import; admin write only)

    match /generalConferenceSessions/{sessionId} {

      allow read: if request.auth != null;

      allow create, update: if isAdmin() && isValidGcSessionData();

      allow delete: if isAdmin();

      match /talks/{talkId} {

        allow read: if request.auth != null;

        allow create, update: if isAdmin() && isValidGcTalkData();

        allow delete: if isAdmin();

      }

    }



    match /users/{userId} {

      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if isValidUserCreate();

      allow update: if isAdmin() || isOwnLastLoginUpdate();

      allow delete: if isAdmin();

    }



    match /invitations/{docId} {

      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == docId);

      allow write: if isAdmin();

    }



    match /emailNotifications/{docId} {

      allow create: if request.auth != null;

      allow read, update, delete: if false;

    }



    match /feedback/{docId} {

      allow create: if isValidFeedbackCreate();

      allow read, update: if isAdmin();

      allow delete: if isAdmin();

    }



    // Telegram subscribers — managed by CFM Helper bot via Admin SDK only

    match /telegramSubscribers/{docId} {

      allow read, write: if false;

    }

  }

}


