rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isEditorOrAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    match /insights/images/{imageId} {
      // Logged-in users can view images embedded in insight content
      allow read: if request.auth != null;
      // TinyMCE uploads — editors/admins only; size and type limits unchanged
      allow create, update: if isEditorOrAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isEditorOrAdmin();
    }
  }
}
